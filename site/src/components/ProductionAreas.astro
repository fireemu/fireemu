---
import { loadRepositoryData, productionAreaRows } from '../data/compat.mjs';
import { pageLocale, statusLabel } from '../i18n/ui.mjs';

const { locale, t } = pageLocale(Astro.url, import.meta.env.BASE_URL);

const rows = productionAreaRows((await loadRepositoryData()).closures);
const products = [...new Set(rows.map((row) => row.product))];
---

{products.map((product) => (
	<>
		<h3>{product}</h3>
		<div class="fe-table-wrap">
		<table>
			<thead>
				<tr><th>{t('table.area')}</th><th>{t('table.status')}</th><th>{t('table.conditionsVerified')}</th></tr>
			</thead>
			<tbody>
				{rows.filter((row) => row.product === product).map((row) => (
					<tr>
						<td>
							<strong>{row.title}</strong>
							<br /><small>{row.covers}</small>
							<details>
								<summary>{t('table.conditions', { count: row.total })}</summary>
								<ul class="conditions">
									{row.conditions.map((c) => (
										<li><code>{c.id}</code>{c.status === 'KNOWN_DIFFERENCE_APPROVED' && ` — ${t('table.knownDifference')}`}</li>
									))}
								</ul>
							</details>
							{row.knownDifferences.length > 0 && (
								<details>
									<summary>{t('table.knownDifferences', { count: row.knownDifferences.length })}</summary>
									<ul>{row.knownDifferences.map((text) => <li>{text}</li>)}</ul>
								</details>
							)}
						</td>
						<td><span class:list={['status', row.status === 'Verified against production' ? 'status-supported' : 'status-partially']}>{statusLabel(locale, row.status)}</span></td>
						<td>{row.verified} / {row.total}</td>
					</tr>
				))}
			</tbody>
		</table>
		</div>
	</>
))}
