---
// Starlight's search, plus the language picker on narrow screens: Starlight shows the picker only
// in the wide header and in the docs' mobile menu, and the landing page has no mobile menu.
import Default from '@astrojs/starlight/components/Search.astro';
import LanguageSelect from './LanguageSelect.astro';
---

<Default />
<div class="fe-mobile-lang md:sl-hidden print:hidden">
	<LanguageSelect />
</div>

<style>
	.fe-mobile-lang {
		display: flex;
		align-items: center;
	}
</style>
