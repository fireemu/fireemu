---
// Starlight's page footer (edit link, previous/next) followed by the site footer, so the landing
// page and every docs page end the same way.
import Default from '@astrojs/starlight/components/Footer.astro';
import { pageLocale } from '../i18n/ui.mjs';

const { t } = pageLocale(Astro.url, import.meta.env.BASE_URL);

const repo = 'https://github.com/fireemu/fireemu';
---

<Default><slot /></Default>
<div class="site-foot not-content">
	<div class="site-foot-row">
		<span>fireemu <span class="muted">{t('footer.tagline')}</span></span>
		<div class="site-foot-links">
			<a href={repo}>GitHub</a>
			<a href="https://www.npmjs.com/package/fireemu">npm</a>
			<a href={`${repo}/blob/main/CHANGELOG.md`}>{t('footer.changelog')}</a>
			<a href={`${repo}/blob/main/docs/development.md`}>{t('footer.contributing')}</a>
			<a href={`${repo}/blob/main/LICENSE`}>Apache-2.0</a>
		</div>
	</div>
	<p class="site-foot-note">
		{t('footer.note')}
	</p>
</div>
