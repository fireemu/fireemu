---
// The landing page, shared by every locale (src/pages/index.astro and src/pages/[locale]/index.astro).
// It renders inside Starlight's page frame, so the header, search, theme and language selectors,
// code blocks and footer are the same components the docs pages use. The words come from
// src/i18n/<locale>.json and internal links stay in the page's locale.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import { loadRepositoryData, verifiedAreaCount } from '../data/compat.mjs';
import { pageLocale } from '../i18n/ui.mjs';
import '../styles/landing.css';

const { to, t } = pageLocale(Astro.url, import.meta.env.BASE_URL);

const verifiedAreas = verifiedAreaCount((await loadRepositoryData()).closures);

const startCommands = `npm install --save-dev fireemu
npx fireemu init
npx fireemu up`;

const startCommandsNix = `nix profile install github:fireemu/fireemu
fireemu init
fireemu up`;

const testCommand = `npx fireemu exec -- npm test`;

const missingIndexOutput = `FirebaseError: [code=failed-precondition]: The query requires an index.
You can create it here: https://console.firebase.google.com/...`;

const worldsExample = `import { withTestWorld } from 'fireemu/testing';

const tests = ['./signup.test.mjs', './account.test.mjs'];

await Promise.all(tests.map((testFile) =>
  withTestWorld(
    {
      projectId: 'demo-app',
      services: ['auth', 'firestore'],
      clockStart: '2026-01-31T23:59:00Z',
    },
    async (world) => {
      await world.clock.advance(60_000);
      await world.run(process.execPath, [testFile]);
    },
  ),
));`;

const features = [
	{ key: 'index', href: to('products/firestore/#composite-indexes'), output: missingIndexOutput },
	{ key: 'totp', href: to('products/auth/#test-totp-enrollment-and-sign-in') },
	{ key: 'blocking', href: to('products/auth/') },
	{ key: 'scheduled', href: to('guides/time/#run-scheduled-functions') },
	{ key: 'search', href: to('products/firestore/#enterprise-text-search') },
].map(({ key, ...rest }) => ({
	...rest,
	title: t(`landing.feature.${key}.title`),
	body: t(`landing.feature.${key}.body`),
	link: t(`landing.feature.${key}.link`),
}));

const service = (key: string, href: string, withLimit = true) => ({
	name: t(`landing.service.${key}.name`),
	href,
	covers: t(`landing.service.${key}.covers`),
	limit: withLimit ? t(`landing.service.${key}.limit`) : undefined,
});

const services: Array<ReturnType<typeof service> & { links?: { label: string; href: string }[] }> = [
	service('firestore', to('products/firestore/')),
	service('auth', to('products/auth/')),
	service('storage', to('products/storage/')),
	{
		...service('functions', to('products/functions/'), false),
		links: [
			{ label: t('landing.service.functions.node'), href: to('products/functions/') },
			{ label: t('landing.service.functions.python'), href: to('products/functions-python/') },
		],
	},
	service('pubsub', to('products/pubsub-eventarc/')),
	service('eventarc', to('products/pubsub-eventarc/')),
	service('rtdb', to('products/realtime-database/')),
	service('hosting', to('products/hosting/')),
	service('remoteconfig', 'https://github.com/fireemu/fireemu/blob/main/docs/remote-config.md'),
	service('appcheck', to('products/app-check/')),
];

const workflow = [
	{ key: 'install', href: to('getting-started/install/') },
	{ key: 'connect', href: to('getting-started/connect/') },
	{ key: 'run', href: to('getting-started/install/#run-a-command-against-the-emulators') },
	{ key: 'ci', href: to('guides/ci-and-containers/') },
].map(({ key, href }) => ({
	title: t(`landing.workflow.${key}.title`),
	body: t(`landing.workflow.${key}.body`),
	guide: t(`landing.workflow.${key}.guide`),
	href,
}));

const resources = [
	{ label: t('landing.resource.cli'), href: to('reference/cli/') },
	{ label: t('landing.resource.config'), href: to('reference/configuration/') },
	{ label: t('landing.resource.rules'), href: to('guides/security-rules/') },
	{ label: t('landing.resource.ui'), href: to('guides/ui/') },
	{ label: t('landing.resource.data'), href: to('guides/data/') },
	{ label: t('landing.resource.troubleshooting'), href: to('guides/troubleshooting/') },
];
---

<StarlightPage
	frontmatter={{
		title: t('landing.title'),
		description: t('landing.description'),
		template: 'splash',
		tableOfContents: false,
	}}
>
	<div class="lp not-content">
		<section class="lp-hero" id="intro">
			<div>
				<h1 id="_top">{t('landing.h1')}</h1>
				<p class="lp-lede">{t('landing.lede')}</p>
				<div class="lp-actions">
					<a class="lp-btn" href={to('getting-started/install/')}>
						{t('landing.install')} <span aria-hidden="true">→</span>
					</a>
					<a class="lp-textlink" href={to('compatibility/')}>{t('landing.exploreCompat')}</a>
				</div>
				<p class="lp-caveat">
					<Fragment set:html={t('landing.caveat')} />{' '}
					<a href={to('guides/profiles/')}>{t('landing.profileBehavior')}</a>
				</p>
			</div>
			<aside class="lp-start" aria-label={t('landing.quickStart')}>
				<Tabs syncKey="install-method">
					<TabItem label="npm">
						<Code code={startCommands} lang="sh" title={t('landing.startLocally')} />
					</TabItem>
					<TabItem label="Nix (Flakes)">
						<Code code={startCommandsNix} lang="sh" title={t('landing.startLocally')} />
					</TabItem>
				</Tabs>
				<p class="lp-meta">{t('landing.platforms')}</p>
				<div class="lp-next">
					<Code code={testCommand} lang="sh" title={t('landing.runTests')} />
					<p class="lp-meta">
						{t('landing.runTestsMeta')}{' '}
						<a href={to('getting-started/connect/')}>{t('landing.connectFirst')}</a>
					</p>
				</div>
			</aside>
		</section>

		<section class="lp-section" id="production">
			<div class="lp-label"><h2>{t('landing.productionHeading')}</h2></div>
			<div>
				{
					features.map((feature) => (
						<article class="lp-feature">
							<h3>{feature.title}</h3>
							<p set:html={feature.body} />
							{feature.output && (
								<Code code={feature.output} lang="ansi" title={t('landing.whatTestSees')} wrap />
							)}
							<a href={feature.href}>{feature.link}</a>
						</article>
					))
				}
				<p class="lp-more">
					<a href={to('compatibility/')}>
						{t('landing.andMore')} <span aria-hidden="true">→</span>
					</a>
				</p>
			</div>
		</section>

		<section class="lp-section" id="testing">
			<div class="lp-label">
				<h2>
					<span>{t('landing.testingHeading1')}</span>
					<span>{t('landing.testingHeading2')}</span>
				</h2>
			</div>
			<div>
				<div class="lp-pair">
					<article>
						<h3>{t('landing.time.title')}</h3>
						<p>{t('landing.time.p1')}</p>
						<p>{t('landing.time.p2')}</p>
						<a href={to('guides/time/')}>{t('landing.time.link')}</a>
					</article>
					<article>
						<h3>{t('landing.worlds.title')}</h3>
						<p>{t('landing.worlds.p1')}</p>
						<p set:html={t('landing.worlds.p2')} />
						<a href={to('guides/test-worlds/')}>{t('landing.worlds.link')}</a>
					</article>
				</div>
				<Code code={worldsExample} lang="js" title={t('landing.worlds.codeTitle')} />
				<p class="lp-boundary">
					<Fragment set:html={t('landing.worlds.boundary')} />{' '}
					<a href={to('guides/test-worlds/#what-a-clock-move-reaches')}>{t('landing.worlds.boundaryLink')}</a>
				</p>
			</div>
		</section>

		<section class="lp-section" id="verification">
			<div class="lp-label"><h2>{t('landing.verificationHeading')}</h2></div>
			<div>
				<div class="lp-evidence">
					<div>
						<p class="lp-intro">{t('landing.verification.intro')}</p>
						<a class="lp-textlink" href={to('compatibility/#production-verification')}>
							{t('landing.verification.link')}
						</a>
					</div>
					<div class="lp-count">
						<strong>{verifiedAreas}</strong>
						<span>{t('landing.verification.count')}</span>
					</div>
				</div>
				<ol class="lp-steps">
					<li>
						<span>01</span>
						<h3>{t('landing.step.record.title')}</h3>
						<p>{t('landing.step.record.body')}</p>
					</li>
					<li>
						<span>02</span>
						<h3>{t('landing.step.compare.title')}</h3>
						<p>{t('landing.step.compare.body')}</p>
					</li>
					<li>
						<span>03</span>
						<h3>{t('landing.step.publish.title')}</h3>
						<p>{t('landing.step.publish.body')}</p>
					</li>
				</ol>
				<p class="lp-boundary">{t('landing.verification.boundary')}</p>
				<div class="lp-differs" id="local-differences">
					<h3>{t('landing.differs.title')}</h3>
					<p>{t('landing.differs.p1')}</p>
					<p>{t('landing.differs.p2')}</p>
					<p class="lp-links">
						<a href={to('guides/profiles/#where-fireemu-departs-from-production-on-purpose')}>
							{t('landing.differs.defaults')}
						</a>
						<a href={to('compatibility/limitations/')}>{t('landing.differs.limitations')}</a>
					</p>
				</div>
			</div>
		</section>

		<section class="lp-section" id="supported-products">
			<div class="lp-label"><h2>{t('landing.servicesHeading')}</h2></div>
			<div>
				<p class="lp-intro">{t('landing.services.intro')}</p>
				<dl class="lp-services">
					{
						services.map((service) => (
							<div>
								<dt>
									<a href={service.href}>{service.name}</a>
								</dt>
								<dd>
									<p>{service.covers}</p>
									{service.limit && <p class="lp-limit">{service.limit}</p>}
									{service.links && (
										<p class="lp-limit lp-links">
											{service.links.map((link) => (
												<a href={link.href}>{link.label}</a>
											))}
										</p>
									)}
								</dd>
							</div>
						))
					}
				</dl>
				<p class="lp-outside">
					{t('landing.services.notSupported')}<br />
					{t('landing.services.notPlanned')}
				</p>
				<p class="lp-links"><a href={to('compatibility/')}>{t('landing.services.records')}</a></p>
			</div>
		</section>

		<section class="lp-section" id="workflow">
			<div class="lp-label"><h2>{t('landing.workflowHeading')}</h2></div>
			<div>
				<ol class="lp-workflow">
					{
						workflow.map((step, index) => (
							<li>
								<span class="lp-stepno">{String(index + 1).padStart(2, '0')}</span>
								<div>
									<h3>{step.title}</h3>
									<p>{step.body}</p>
								</div>
								<a href={step.href}>
									{step.guide} <span aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ol>
				<p class="lp-boundary">
					<Fragment set:html={t('landing.migrate')} />{' '}
					<a href={to('getting-started/migrate/')}>{t('landing.migrateLink')}</a>
				</p>
			</div>
		</section>

		<section class="lp-section lp-resources" id="resources">
			<div class="lp-label"><h2>{t('landing.docsHeading')}</h2></div>
			<div class="lp-resource-list">
				{
					resources.map((resource) => (
						<a href={resource.href}>
							{resource.label} <span aria-hidden="true">→</span>
						</a>
					))
				}
			</div>
		</section>
	</div>
</StarlightPage>
