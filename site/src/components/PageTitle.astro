---
// The landing page writes its own <h1> inside the hero; every other page keeps Starlight's title.
// The landing page of every locale (/, /ja/, ...) counts.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { pageLocale } from '../i18n/ui.mjs';

const isLanding = pageLocale(Astro.url, import.meta.env.BASE_URL).rest.replace(/\/$/, '') === '';
---

{!isLanding && <Default />}
