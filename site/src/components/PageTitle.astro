---
// The landing page writes its own <h1> inside the hero; every other page keeps Starlight's title.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isLanding = Astro.url.pathname.replace(/\/$/, '') === base;
---

{!isLanding && <Default />}
