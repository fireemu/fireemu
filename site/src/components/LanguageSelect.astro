---
// The language picker as an icon menu of links to the same page in each language.
import IconMenu from './IconMenu.astro';
import { locales, localePrefix } from '../i18n/locales.mjs';
import { pageLocale } from '../i18n/ui.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { locale, rest: path } = pageLocale(Astro.url, import.meta.env.BASE_URL);
// The not-found page has no counterpart page; its picker leads to each language's home.
const rest = /^404\/?$/.test(path) ? '' : path;
---

<IconMenu icon="translate" label={Astro.locals.t('languageSelect.accessibleLabel')}>
	{
		Object.entries(locales).map(([code, { label, lang }]) => (
			<a href={`${base}/${localePrefix(code)}${rest}`} hreflang={lang} lang={lang} aria-current={code === locale ? 'true' : undefined}>
				{label}
			</a>
		))
	}
</IconMenu>
