---
// Replaces Starlight's SocialIcons slot in the header: text links to the site sections first,
// then npm and GitHub as icons. The same header serves the landing page and the docs pages.
// The section links stay in the page's locale.
import { headerNav, currentNavSlug } from '../data/header-nav.mjs';
import { pageLocale } from '../i18n/ui.mjs';
import { Icon } from '@astrojs/starlight/components';

const { rest, to, t } = pageLocale(Astro.url, import.meta.env.BASE_URL);
const current = currentNavSlug(rest);
---

<nav class="header-nav sl-flex" aria-label={t('nav.label')}>
	{
		headerNav.map(({ label, key, slug, href, icon }) =>
			slug ? (
				<a href={to(`${slug}/`)} aria-current={slug === current ? 'page' : undefined}>
					{key ? t(key) : label}
				</a>
			) : (
				<a class="external" href={href} rel="noopener noreferrer" aria-label={label} title={label}>
					<Icon name={icon} class="external-icon" />
				</a>
			),
		)
	}
</nav>

<style>
	.header-nav {
		gap: 1.375rem;
		align-items: center;
	}
	.header-nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.3125rem;
		min-height: 2.75rem;
		color: var(--fe-fg);
		font-size: var(--fe-text-min);
		text-decoration: none;
		white-space: nowrap;
	}
	.header-nav a.external {
		justify-content: center;
		min-width: 2.25rem;
		color: var(--sl-color-gray-2);
	}
	.header-nav a.external :global(.external-icon) {
		font-size: 1.25rem;
	}
	.header-nav a:hover {
		color: var(--fe-accent);
	}
	.header-nav a[aria-current='page'] {
		font-weight: 600;
		box-shadow: inset 0 -3px 0 var(--fe-brand);
	}
	/* The section links give way first; the sidebar (or the landing page itself) reaches the same pages. */
	@media (max-width: 71.9375rem) {
		.header-nav a:not(.external):not(:first-child) {
			display: none;
		}
	}
	/* In the mobile menu footer, lay the links out as a wrapping row. */
	:global(.mobile-preferences) .header-nav {
		flex-wrap: wrap;
	}
	:global(.mobile-preferences) .header-nav a:not(.external):not(:first-child) {
		display: none;
	}
</style>
