{
  "name": "fireemu",
  "version": "0.0.0-dev",
  "description": "A local runtime for testing Firebase SDK and Functions code, checked against production Firebase behavior",
  "keywords": [
    "emulator",
    "firebase",
    "firebase-functions",
    "firestore",
    "testing"
  ],
  "homepage": "https://fireemu.github.io/fireemu/",
  "bugs": "https://github.com/fireemu/fireemu/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fireemu/fireemu.git"
  },
  "bin": {
    "fireemu": "bin/fireemu.mjs"
  },
  "files": [
    "bin/fireemu.mjs",
    "binary.mjs",
    "control.mjs",
    "control.d.mts",
    "testing.mjs",
    "testing.d.mts",
    "vitest.mjs",
    "vitest.d.mts",
    "playwright.mjs",
    "playwright.d.mts",
    "testing-snapshot.mjs",
    "testing-queue.mjs",
    "testing-clock.mjs",
    "testing-process.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "type": "module",
  "optionalDependencies": {
    "@fireemu/darwin-arm64": "0.0.0-dev",
    "@fireemu/darwin-x64": "0.0.0-dev",
    "@fireemu/linux-arm64": "0.0.0-dev",
    "@fireemu/linux-x64": "0.0.0-dev",
    "@fireemu/win32-x64": "0.0.0-dev"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./testing": {
      "types": "./testing.d.mts",
      "default": "./testing.mjs"
    },
    "./vitest": {
      "types": "./vitest.d.mts",
      "default": "./vitest.mjs"
    },
    "./playwright": {
      "types": "./playwright.d.mts",
      "default": "./playwright.mjs"
    },
    "./package.json": "./package.json",
    "./control": {
      "types": "./control.d.mts",
      "default": "./control.mjs"
    }
  }
}
