        },
        "fireemu_obs_numeric_ge": {
          "value": "value-fireemu_obs_numeric_ge"
        },
        "fireemu_obs_string_contains": {
          "value": "value-fireemu_obs_string_contains"
        },
        "fireemu_obs_string_not_contains": {
          "value": "value-fireemu_obs_string_not_contains"
        },
        "fireemu_obs_string_regex": {
          "value": "value-fireemu_obs_string_regex"
        },
        "fireemu_obs_semver_lt": {
          "value": "value-fireemu_obs_semver_lt"
        },
        "fireemu_obs_semver_le": {
          "value": "value-fireemu_obs_semver_le"
        },
        "fireemu_obs_semver_eq": {
          "value": "value-fireemu_obs_semver_eq"
        },
        "fireemu_obs_semver_ne": {
          "value": "value-fireemu_obs_semver_ne"
        },
