  },
  "parameterGroups": {
    "fireemu_obs_group": {
      "description": "Fireemu observation group",
      "parameters": {
        "fireemu_obs_number": {
          "defaultValue": {
            "value": "12.5"
          },
          "valueType": "NUMBER"
        },
        "fireemu_obs_json": {
          "defaultValue": {
            "value": "{\"a\":1}"
          },
          "conditionalValues": {
            "fireemu_obs_percent_between": {
              "value": "{\"a\":2}"
            }
          },
          "valueType": "JSON"
        }
      }
