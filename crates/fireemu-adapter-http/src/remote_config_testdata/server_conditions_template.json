{
  "conditions": [
    {
      "name": "fireemu_obs_percent_between",
      "expression": "percent('fireemu_obs') between 10 and 60"
    },
    {
      "name": "fireemu_obs_percent_between_fraction",
      "expression": "percent('fireemu_obs') between 0.5 and 99.25"
    },
    {
      "name": "fireemu_obs_percent_greater",
      "expression": "percent('fireemu_obs') > 50"
    },
    {
      "name": "fireemu_obs_percent_unseeded",
      "expression": "percent <= 50"
    },
    {
      "name": "fireemu_obs_numeric_lt",
      "expression": "app.customSignal['fireemu_n'] < 5"
    },
    {
      "name": "fireemu_obs_numeric_le",
      "expression": "app.customSignal['fireemu_n'] <= 5"
    },
    {
      "name": "fireemu_obs_numeric_eq",
      "expression": "app.customSignal['fireemu_n'] == 5"
    },
    {
      "name": "fireemu_obs_numeric_ne",
      "expression": "app.customSignal['fireemu_n'] != 5"
    },
    {
      "name": "fireemu_obs_numeric_gt",
      "expression": "app.customSignal['fireemu_n'] > 5"
    },
    {
      "name": "fireemu_obs_numeric_ge",
      "expression": "app.customSignal['fireemu_n'] >= 5"
    },
    {
      "name": "fireemu_obs_string_contains",
      "expression": "app.customSignal['fireemu_s'].contains(['ab'])"
    },
    {
      "name": "fireemu_obs_string_not_contains",
      "expression": "app.customSignal['fireemu_s'].notContains(['ab'])"
    },
    {
      "name": "fireemu_obs_string_regex",
      "expression": "app.customSignal['fireemu_s'].matches(['^ab$'])"
    },
    {
      "name": "fireemu_obs_semver_lt",
      "expression": "version(app.customSignal['fireemu_v']) < '1.2.3'"
    },
    {
      "name": "fireemu_obs_semver_le",
      "expression": "version(app.customSignal['fireemu_v']) <= '1.2.3'"
    },
    {
      "name": "fireemu_obs_semver_eq",
      "expression": "version(app.customSignal['fireemu_v']) == '1.2.3'"
    },
    {
      "name": "fireemu_obs_semver_ne",
      "expression": "version(app.customSignal['fireemu_v']) != '1.2.3'"
    },
    {
      "name": "fireemu_obs_semver_gt",
      "expression": "version(app.customSignal['fireemu_v']) > '1.2.3'"
    },
    {
      "name": "fireemu_obs_semver_ge",
      "expression": "version(app.customSignal['fireemu_v']) >= '1.2.3'"
    },
    {
      "name": "fireemu_obs_and",
      "expression": "app.customSignal['fireemu_s'].exactlyMatches(['a']) && percent('fireemu_obs') <= 50"
    }
  ],
  "parameters": {
    "fireemu_obs_top": {
      "defaultValue": {
        "value": "default"
      },
      "conditionalValues": {
        "fireemu_obs_percent_between": {
          "value": "value-fireemu_obs_percent_between"
        },
        "fireemu_obs_percent_between_fraction": {
          "value": "value-fireemu_obs_percent_between_fraction"
        },
        "fireemu_obs_percent_greater": {
          "value": "value-fireemu_obs_percent_greater"
        },
        "fireemu_obs_percent_unseeded": {
          "value": "value-fireemu_obs_percent_unseeded"
        },
        "fireemu_obs_numeric_lt": {
          "value": "value-fireemu_obs_numeric_lt"
        },
        "fireemu_obs_numeric_le": {
